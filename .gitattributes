# Keep LF-authored Foundation payload byte-identical on Windows checkouts.
* text=auto
/.gitattributes text eol=lf
/.editorconfig text eol=lf
/.gitignore text eol=lf
/LICENSE text eol=lf
/.github/CODEOWNERS text eol=lf
/.ai/foundation/ARTIFACT_REGISTRATION_POLICY.md text eol=lf
/.ai/foundation/CENTRAL_ARTIFACT_REGISTRY_POLICY.md text eol=lf
/.ai/foundation/FOUNDATION_RULESET.md text eol=lf
/.ai/foundation/PROJECT_RULES.md text eol=lf
/.ai/foundation/SEMANTIC_INTEGRATION_POLICY.md text eol=lf
/.ai/foundation/UPGRADE_APPLICABILITY_POLICY.md text eol=lf
/.ai/foundation/feature_catalog.json text eol=lf
/.ai/foundation/repo_map.yaml text eol=lf
/.ai/foundation/schemas/artifact-registry-v2.schema.json text eol=lf
/.ai/foundation/schemas/feature-catalog.schema.json text eol=lf
/.ai/foundation/schemas/upgrade-assessment.schema.json text eol=lf

# Project-authored text files use stable LF line endings on all platforms.
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
Containerfile text eol=lf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary

# TEST-0001 binary inputs must remain byte-identical to their manifest hashes.
/tests/fixtures/**/*.epub binary
/tests/fixtures/**/*.pdf binary
/tests/fixtures/**/*.part binary
