FROM docker.io/library/python@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ARG JRE_URL="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jre_x64_linux_hotspot_21.0.12_8.tar.gz"
ARG JRE_SHA256="8a379a67c91a3ae61ffb33d46e0a40c7ba35e70713c4db31cfca30492f792eff"
ARG EPUBCHECK_URL="https://github.com/w3c/epubcheck/releases/download/v5.3.0/epubcheck-5.3.0.zip"
ARG EPUBCHECK_SHA256="6c07e68584b2e2ce2f89fe06e1246dfead3eb36b46b340e7d93524f29dcff6c5"

LABEL org.opencontainers.image.title="SammlungsLotse EXP-0005 EPUBCheck probe"
LABEL org.opencontainers.image.description="Disposable synthetic qualification image; not a product runtime"
LABEL org.opencontainers.image.source="https://github.com/gecompat/SammlungsLotse"
LABEL org.opencontainers.image.version="exp-0005-podman-epubcheck-5.3.0/v1"

COPY bootstrap_tools.py /tmp/bootstrap_tools.py
RUN python /tmp/bootstrap_tools.py \
      --destination /opt \
      --jre-url "${JRE_URL}" \
      --jre-sha256 "${JRE_SHA256}" \
      --epubcheck-url "${EPUBCHECK_URL}" \
      --epubcheck-sha256 "${EPUBCHECK_SHA256}" \
    && rm /tmp/bootstrap_tools.py

COPY probe.py /opt/experiment/probe.py

ENV JAVA_HOME=/opt/java \
    LANG=C.UTF-8 \
    HOME=/tmp/home \
    PATH=/opt/java/bin:/usr/local/bin:/usr/bin:/bin

USER 65532:65532
ENTRYPOINT ["/usr/bin/env", "-i", "JAVA_HOME=/opt/java", "LANG=C.UTF-8", "HOME=/tmp/home", "PATH=/opt/java/bin:/usr/local/bin:/usr/bin:/bin", "python", "/opt/experiment/probe.py"]
